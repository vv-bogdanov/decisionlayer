#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "src"))

from decision_layer.slopcodebench import write_summary_files  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Summarize SlopCodeBench D0/D1 run artifacts.")
    parser.add_argument("run_root", help="Run root containing D0 and/or D1 directories.")
    parser.add_argument("--mode", action="append", choices=("D0", "D1"))
    args = parser.parse_args()

    modes = args.mode or ["D0", "D1"]
    summary = write_summary_files(Path(args.run_root), modes)
    print(json.dumps(summary["modes"], indent=2, sort_keys=True))
    print(f"Wrote {Path(args.run_root) / 'summary.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
