#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SKIP_LAB=0
SKIP_BUILD=0

usage() {
  cat <<'EOF'
Usage: scripts/check [--quick] [--skip-lab] [--skip-build]

Runs the local publication/readiness checks:
  ruff, mypy, coverage, plugin validation when available, lab doctor, and build.

Options:
  --quick       Skip lab doctor and package build.
  --skip-lab    Skip isolated Codex plugin lab checks.
  --skip-build  Skip uv build.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --quick)
      SKIP_LAB=1
      SKIP_BUILD=1
      ;;
    --skip-lab)
      SKIP_LAB=1
      ;;
    --skip-build)
      SKIP_BUILD=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

cd "$ROOT"

run() {
  echo
  echo "==> $*"
  "$@"
}

run uv run --extra dev ruff check .
run uv run --extra dev mypy repo_decisions tests benchmarks
run uv run repo-decisions --help
run uv run --extra dev python -m coverage run -m unittest discover -s tests -v
run uv run --extra dev python -m coverage report

PLUGIN_VALIDATOR="${PLUGIN_VALIDATOR:-$HOME/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py}"
if [ -f "$PLUGIN_VALIDATOR" ]; then
  run python3 "$PLUGIN_VALIDATOR" "$ROOT/plugins/repo-decisions"
else
  echo
  echo "==> skipping plugin validation; set PLUGIN_VALIDATOR to validate plugin schema"
fi

if [ "$SKIP_LAB" -eq 0 ]; then
  run scripts/codex-plugin-lab doctor
fi

if [ "$SKIP_BUILD" -eq 0 ]; then
  run uv build
fi
