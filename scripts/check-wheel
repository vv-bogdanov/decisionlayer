#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

TMP_DIR="$(mktemp -d)"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

echo "Building wheel"
rm -f "$ROOT"/dist/repo_decisions-*.whl
uv build --wheel

WHEEL="$(find "$ROOT/dist" -maxdepth 1 -type f -name 'repo_decisions-*.whl' | sort | tail -n 1)"
if [ -z "$WHEEL" ]; then
  echo "No repo_decisions wheel found in dist/" >&2
  exit 1
fi

echo "Installing wheel into temporary venv"
UV_LINK_MODE=copy uv venv "$TMP_DIR/venv" >/dev/null
UV_LINK_MODE=copy uv pip install --python "$TMP_DIR/venv/bin/python" "$WHEEL" >/dev/null

echo "Checking installed CLI"
"$TMP_DIR/venv/bin/repo-decisions" --help >/dev/null

FIXTURE="$TMP_DIR/code_follows_adr"
cp -R "$ROOT/benchmarks/adr_agent/fixtures/code_follows_adr" "$FIXTURE"
BRIEF="$("$TMP_DIR/venv/bin/repo-decisions" --root "$FIXTURE" brief)"
if [[ "$BRIEF" != *"Application event logs are newline-delimited JSON"* ]]; then
  echo "Installed CLI did not produce the expected ADR brief" >&2
  exit 1
fi

echo "Wheel install smoke passed: $WHEEL"
