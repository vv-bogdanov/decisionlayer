#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB_ROOT="${REPO_DECISIONS_CODEX_LAB_DIR:-$ROOT/.codex-lab}"
LAB_HOME="$LAB_ROOT/home"
DEBUG_LOG="$LAB_ROOT/repo-decisions-debug.jsonl"
MARKETPLACE_ROOT="$ROOT"
PLUGIN_ID="repo-decisions@memorycore-local"

usage() {
  cat <<'EOF'
Usage: scripts/codex-plugin-lab <command> [args...]

Commands:
  init          Create isolated CODEX_HOME and install the local plugin there
  doctor        Run isolated plugin install, MCP listing, and hook smoke checks
  mcp-list      Show MCP servers from the isolated CODEX_HOME
  hooks-list    Query app-server hooks/list from the isolated CODEX_HOME
  hook-smoke    Run the installed UserPromptSubmit hook directly with a fixture ADR
  runtime-smoke Run codex exec in the lab and verify hook-context evidence
  interactive   Start Codex with the isolated CODEX_HOME and debug log
  clean         Remove the isolated lab directory

The lab always uses .codex-lab/home by default and never uses the caller's
CODEX_HOME. Override the lab root with REPO_DECISIONS_CODEX_LAB_DIR.
EOF
}

ensure_safe_home() {
  mkdir -p "$LAB_HOME"
  local real_lab
  real_lab="$(cd -P "$LAB_HOME" && pwd)"
  local main_home="$HOME/.codex"
  if [ -d "$main_home" ]; then
    main_home="$(cd -P "$main_home" && pwd)"
  fi
  if [ "$real_lab" = "$main_home" ]; then
    echo "Refusing to use main Codex home as lab: $real_lab" >&2
    exit 2
  fi
}

lab_codex() {
  ensure_safe_home
  CODEX_HOME="$LAB_HOME" "$@"
}

install_plugin() {
  ensure_safe_home
  mkdir -p "$LAB_ROOT"
  lab_codex codex plugin marketplace add "$MARKETPLACE_ROOT"
  lab_codex codex plugin add "$PLUGIN_ID"
}

plugin_root() {
  ensure_safe_home
  local root="$LAB_HOME/plugins/cache/memorycore-local/repo-decisions"
  if [ ! -d "$root" ]; then
    echo "Plugin is not installed in lab home. Run: scripts/codex-plugin-lab init" >&2
    exit 2
  fi
  find "$root" -mindepth 1 -maxdepth 1 -type d | sort | tail -n 1
}

hook_smoke() {
  install_plugin >/dev/null
  local installed_root
  installed_root="$(plugin_root)"
  local fixture
  fixture="$(mktemp -d)"
  write_fixture_adr "$fixture"
  mkdir -p "$LAB_ROOT"
  local output
  output="$(
    REPO_DECISIONS_DEBUG_LOG="$DEBUG_LOG" \
      "$installed_root/scripts/user-prompt-submit" \
      <<<"{\"cwd\":\"$fixture\",\"hook_event_name\":\"UserPromptSubmit\"}"
  )"
  rm -rf "$fixture"
  if [[ "$output" != *"Repository ADR Decisions"* ]]; then
    echo "Hook smoke failed: expected ADR context in output" >&2
    echo "$output" >&2
    exit 1
  fi
  if [[ "$output" != *"Use SQLite for fixture persistence"* ]]; then
    echo "Hook smoke failed: expected fixture decision in output" >&2
    echo "$output" >&2
    exit 1
  fi
  echo "Hook smoke passed"
  echo "Debug log: $DEBUG_LOG"
}

write_fixture_adr() {
  local fixture="$1"
  mkdir -p "$fixture/docs/adr"
  cat >"$fixture/docs/adr/0001-use-sqlite.md" <<'EOF'
# 1. Use SQLite

Date: 2026-06-05

## Status

Accepted

## Context and Problem Statement

The fixture needs a tiny durable store.

## Decision

Use SQLite for fixture persistence.

## Consequences

No external database is required.
EOF
}

runtime_smoke() {
  install_plugin >/dev/null
  mkdir -p "$LAB_ROOT/runtime-smoke"
  local run_dir
  run_dir="$(mktemp -d "$LAB_ROOT/runtime-smoke/run.XXXXXX")"
  local fixture="$run_dir/fixture"
  local debug_log="$run_dir/repo-decisions-debug.jsonl"
  local stdout_log="$run_dir/codex.jsonl"
  local stderr_log="$run_dir/codex.stderr"
  local last_message="$run_dir/last-message.txt"
  mkdir -p "$fixture"
  write_fixture_adr "$fixture"
  git -C "$fixture" init -q

  set +e
  REPO_DECISIONS_DEBUG_LOG="$debug_log" \
    CODEX_HOME="$LAB_HOME" \
    codex exec \
      --dangerously-bypass-hook-trust \
      --skip-git-repo-check \
      -C "$fixture" \
      --json \
      --output-last-message "$last_message" \
      "Reply with exactly OK." \
      >"$stdout_log" 2>"$stderr_log"
  local status=$?
  set -e

  if [ -f "$debug_log" ] && grep -q '"event": "hook-context"' "$debug_log"; then
    if [ "$status" -eq 0 ]; then
      echo "Runtime smoke passed"
      echo "Artifacts: $run_dir"
      return 0
    fi
    echo "Runtime hook-context was recorded, but codex exec failed with status $status." >&2
    echo "Artifacts: $run_dir" >&2
    return "$status"
  fi

  if grep -Eiq '401 Unauthorized|Missing bearer|not logged in|authentication' "$stderr_log" "$stdout_log"; then
    cat >&2 <<EOF
Runtime smoke could not prove hook execution because the lab CODEX_HOME is not authenticated.

Authenticate only the isolated lab home, then retry:
  CODEX_HOME=$LAB_HOME codex login
  scripts/codex-plugin-lab runtime-smoke

Artifacts: $run_dir
EOF
    return 2
  fi

  cat >&2 <<EOF
Runtime smoke failed: codex exec completed without a hook-context debug event.

This means the plugin hook was not run in the tested runtime path, even though
direct hook smoke and hooks/list may still pass. Keep using the wrapper fallback
or verify the hook in an interactive lab session.

Artifacts: $run_dir
EOF
  return 1
}

hooks_list() {
  install_plugin >/dev/null
  CODEX_HOME="$LAB_HOME" ROOT="$ROOT" python3 - <<'PY'
from __future__ import annotations

import json
import os
import select
import subprocess
import sys
import time


root = os.environ["ROOT"]
env = os.environ.copy()
proc = subprocess.Popen(
    ["codex", "app-server", "--stdio"],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    env=env,
    cwd=root,
)
assert proc.stdin is not None
assert proc.stdout is not None


def send(message: dict) -> None:
    proc.stdin.write(json.dumps(message) + "\n")
    proc.stdin.flush()


def read_response(request_id: int, timeout: float = 5.0) -> dict:
    deadline = time.monotonic() + timeout
    fd = proc.stdout.fileno()
    while time.monotonic() < deadline:
        remaining = max(0.0, deadline - time.monotonic())
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            break
        line = proc.stdout.readline()
        if not line:
            break
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("id") == request_id:
            return message
    raise RuntimeError(f"Timed out waiting for app-server response id={request_id}")


try:
    send(
        {
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {"name": "repo-decisions-lab", "version": "0.1.0"},
                "capabilities": {
                    "experimentalApi": True,
                    "requestAttestation": False,
                },
            },
        }
    )
    read_response(1)
    send({"id": 2, "method": "hooks/list", "params": {"cwds": [root]}})
    response = read_response(2)
finally:
    proc.stdin.close()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.terminate()
        proc.wait(timeout=5)

if "error" in response:
    raise RuntimeError(response["error"])

entries = response.get("result", {}).get("data", [])
matches = [
    hook
    for entry in entries
    for hook in entry.get("hooks", [])
    if hook.get("pluginId") == "repo-decisions@memorycore-local"
    and hook.get("eventName") == "userPromptSubmit"
    and hook.get("source") == "plugin"
]
if not matches:
    stderr = proc.stderr.read() if proc.stderr is not None else ""
    if stderr:
        print(stderr, file=sys.stderr)
    raise RuntimeError("repo-decisions UserPromptSubmit hook was not listed")
hook = matches[0]
if not hook.get("enabled"):
    raise RuntimeError("repo-decisions UserPromptSubmit hook is listed but disabled")
print(
    "Hook list passed: "
    f"{hook.get('pluginId')} {hook.get('eventName')} "
    f"trust={hook.get('trustStatus')} hash={hook.get('currentHash')}"
)
PY
}

command="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  init)
    install_plugin
    echo "Lab CODEX_HOME: $LAB_HOME"
    echo "Debug log: $DEBUG_LOG"
    ;;
  doctor)
    install_plugin
    lab_codex codex mcp list
    hooks_list
    hook_smoke
    ;;
  mcp-list)
    lab_codex codex mcp list
    ;;
  hooks-list)
    hooks_list
    ;;
  hook-smoke)
    hook_smoke
    ;;
  runtime-smoke)
    runtime_smoke
    ;;
  interactive)
    install_plugin >/dev/null
    mkdir -p "$LAB_ROOT"
    echo "Lab CODEX_HOME: $LAB_HOME"
    echo "Debug log: $DEBUG_LOG"
    REPO_DECISIONS_DEBUG_LOG="$DEBUG_LOG" \
      CODEX_HOME="$LAB_HOME" \
      codex --dangerously-bypass-hook-trust "$@"
    ;;
  clean)
    rm -rf "$LAB_ROOT"
    echo "Removed $LAB_ROOT"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
