#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ -n "${PYTHON:-}" ]; then
  PYTHON_BIN="$PYTHON"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON_BIN="$ROOT/.venv/bin/python"
else
  PYTHON_BIN="python3"
fi

if ! "$PYTHON_BIN" -m coverage --version >/dev/null 2>&1; then
  cat >&2 <<'EOF'
coverage is not installed.

Install dev dependencies first, for example:
  uv sync --extra dev

Then run:
  .venv/bin/python -m coverage run -m unittest discover -s tests -v
  .venv/bin/python -m coverage report
EOF
  exit 2
fi

echo "Using Python: $PYTHON_BIN"
"$PYTHON_BIN" -m coverage run -m unittest discover -s tests -v
"$PYTHON_BIN" -m coverage report
